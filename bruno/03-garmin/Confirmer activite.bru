meta {
  name: Confirmer une activité Garmin
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/garmin/synchronisations/{{synchronisationId}}/confirmation
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Requete-Pace: interface-web
}

body:json {
  {
    "idExterne": "{{candidatGarminId}}"
  }
}
