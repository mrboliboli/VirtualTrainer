meta {
  name: Connexion Garmin
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/garmin/connexion
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Requete-Pace: interface-web
}

body:json {
  {
    "identifiant": "{{garminEmail}}",
    "motDePasse": "{{garminPassword}}",
    "consentementRisques": true
  }
}

script:post-response {
  if (res.body && res.body.defiMfaId) {
    bru.setEnvVar("defiMfaId", res.body.defiMfaId);
  }
}
