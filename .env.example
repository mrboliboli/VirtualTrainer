# Copier ce fichier vers .env et remplacer toutes les valeurs marquées.
PACE_LISTEN_ADDRESS=127.0.0.1
PACE_HTTP_PORT=8080
PACE_ACCESS_PASSWORD=a-remplacer-par-un-mot-de-passe-long
PACE_API_ACCESS_TOKEN=a-remplacer-par-un-secret-interne-distinct
PACE_DATABASE_PASSWORD=a-remplacer-par-un-secret-long
PACE_CONNECTOR_API_TOKEN=a-remplacer-par-un-secret-inter-service
PACE_CONNECTOR_ENCRYPTION_KEY=a-remplacer-par-une-cle-base64-url-de-32-octets
PACE_CONNECTOR_ENABLED=false
